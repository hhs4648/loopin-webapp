VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Haksup TTS (영·한 여성 Neural) — Supabase Edge Function 배포 필요
# supabase functions deploy haksup-tts

# 선생님 웹 주소 — 앱에는 선생님 화면이 없고, 온보딩 뒤 이 주소로 안내한다.
# **안 넣어도 된다.** 코드에 기본값(`DEFAULT_TEACHER_WEB_URL`)이 있어서 비워 두면 그걸 쓴다.
# 스테이징 등 다른 주소를 가리킬 때만 넣는다.
VITE_TEACHER_WEB_URL=

# 개발용 임시 로그인 버튼. 소셜 로그인 provider 등록 전까지 앱에 들어가려면 필요하다.
# npm run dev 에서는 값과 무관하게 항상 보인다. 프로덕션 배포에는 절대 넣지 말 것.
VITE_ALLOW_DEV_LOGIN=false

# App Store 심사용 데모 로그인. 스토어 빌드는 true일 때만 버튼이 노출된다.
# 로컬 `npm run dev`에서는 값과 무관하게 버튼이 보인다(비밀번호 1234 · 온보딩 생략).
# VITE_DEMO_INVITE_CODE 가 비면 기본 데모 반(AB6NKL)을 쓴다.
VITE_APP_REVIEW_DEMO=false
VITE_DEMO_INVITE_CODE=
VITE_DEMO_LOGIN_PASSWORD=1234
