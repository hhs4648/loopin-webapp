VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Loopin TTS (영·한 여성 Neural) — Supabase Edge Function 배포 필요
# supabase functions deploy loopin-tts

# 선생님 웹 주소 — 앱에는 선생님 화면이 없고, 온보딩 뒤 이 주소로 안내한다.
# 비어 있으면 안내 화면에 「아직 연결되지 않았어요」가 표시된다.
VITE_TEACHER_WEB_URL=https://YOUR_TEACHER_WEB_DOMAIN

# 개발용 임시 로그인 버튼. 소셜 로그인 provider 등록 전까지 앱에 들어가려면 필요하다.
# npm run dev 에서는 값과 무관하게 항상 보인다. 프로덕션 배포에는 절대 넣지 말 것.
VITE_ALLOW_DEV_LOGIN=false
